{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "cv": "node scripts/cv-json.mjs | cargo run --quiet --locked --manifest-path ../cvgen/Cargo.toml -- - public/cv",
    "predev": "npm run cv",
    "dev": "vite",
    "prebuild": "npm run cv",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "simple-icons": "^16.26.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
